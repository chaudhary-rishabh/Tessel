{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrPull",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadAppSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParametersByPath", "ssm:GetParameters", "ssm:GetParameter"],
      "Resource": [
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/tessel/prod",
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/tessel/prod/*"
      ]
    },
    {
      "Sid": "AppFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/workspaces/*"
    },
    {
      "Sid": "AppFilesList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["workspaces/*"]
        }
      }
    },
    {
      "Sid": "UploadEvents",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:SendMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:REGION:ACCOUNT_ID:tessel-uploads"
    },
    {
      "Sid": "Backups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::BACKUP_BUCKET_NAME/postgres/*",
        "arn:aws:s3:::BACKUP_BUCKET_NAME/qdrant/*"
      ]
    },
    {
      "Sid": "SendEmail",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": "arn:aws:ses:REGION:ACCOUNT_ID:identity/*"
    },
    {
      "Sid": "ContainerLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"],
      "Resource": [
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/tessel/prod",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/tessel/prod:*"
      ]
    }
  ]
}
