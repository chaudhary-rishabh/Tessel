# Copy to /opt/tessel/deploy.env on the EC2 host. Not secret: these only tell
# Compose which images to run and which domains to serve. The deploy workflow
# writes this file on every deploy from GitHub repository variables.

AWS_REGION=ap-south-1
ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com

# Profiles to run: edge (Caddy + HTTPS) and data (databases on this host).
# Add web to serve the web app from this host instead of Vercel, and voice
# for voice conversations (LiveKit and the voice agent).
COMPOSE_PROFILES=edge,data,voice

# Where app secrets live in SSM Parameter Store.
SSM_PATH=/tessel/prod

# The web app's domain (on Vercel unless the web profile is on).
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
MCP_DOMAIN=mcp.example.com
ADMIN_DOMAIN=admin.example.com
# LiveKit's signalling, for voice (the voice profile). Point it at this host too.
RTC_DOMAIN=rtc.example.com
ACME_EMAIL=you@example.com

# Optional: nightly Postgres and search index backups to this S3 bucket (data profile only).
BACKUP_BUCKET=
# Optional: send every container's logs to this CloudWatch log group.
LOG_GROUP=
