# Copy to /opt/tessel/deploy.env on the EC2 host. Not secret: these only tell
# Compose which images to run and which domains to serve. The deploy workflow
# writes this file on every deploy from GitHub repository variables.

AWS_REGION=ap-south-1
ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com

# Profiles to run: edge (Caddy + HTTPS) and data (databases on this host).
COMPOSE_PROFILES=edge,data

# Where app secrets live in SSM Parameter Store.
SSM_PATH=/tessel/prod

WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
MCP_DOMAIN=mcp.example.com
ACME_EMAIL=you@example.com
