# Throwaway values for the CI smoke test of the production images. Not used anywhere else.
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=1
JWT_ACCESS_SECRET=ci-smoke-test-secret-that-is-long-enough-0123456789
POSTGRES_PASSWORD=ci-postgres-password
DATABASE_MIGRATION_URL=postgres://tessel:ci-postgres-password@postgres:5432/tessel
DATABASE_URL=postgres://tessel_app:ci-app-password@postgres:5432/tessel
REDIS_CACHE_URL=redis://redis-cache:6379
REDIS_QUEUE_URL=redis://redis-queue:6379
QDRANT_URL=http://qdrant:6333
NEO4J_HTTP_URL=http://neo4j:7474
NEO4J_AUTH=neo4j/ci-neo4j-password
