# Throwaway values for the CI smoke test of the production images. Not used anywhere else.
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=1
JWT_ACCESS_SECRET=ci-smoke-test-secret-that-is-long-enough-0123456789
API_PUBLIC_URL=http://localhost:4000
MCP_PUBLIC_URL=http://localhost:4100
ENCRYPTION_KEY=Y2ktc21va2UtdGVzdC1jb25uZWN0b3Ita2V5LTMyYiE=
MAIL_TRANSPORT=ses
MAIL_FROM=Tessel <no-reply@example.com>
# The AWS SDK sends SES calls to the mock in docker-compose.emulators.yml.
AWS_ENDPOINT_URL_SESV2=http://ses:8005
POSTGRES_PASSWORD=ci-postgres-password
DATABASE_MIGRATION_URL=postgres://tessel:ci-postgres-password@postgres:5432/tessel
DATABASE_URL=postgres://tessel_app:ci-app-password@postgres:5432/tessel
REDIS_CACHE_URL=redis://redis-cache:6379
REDIS_QUEUE_URL=redis://redis-queue:6379
QDRANT_URL=http://qdrant:6333
NEO4J_HTTP_URL=http://neo4j:7474
NEO4J_BOLT_URL=bolt://neo4j:7687
NEO4J_AUTH=neo4j/ci-neo4j-password
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tessel-local
AWS_SECRET_ACCESS_KEY=tessel-local-secret
S3_BUCKET=tessel-smoke
S3_ENDPOINT=http://objectstore:8333
S3_FORCE_PATH_STYLE=true
SQS_ENDPOINT=http://sqs:9324
SQS_UPLOADS_QUEUE_URL=http://sqs:9324/000000000000/tessel-uploads
UPLOAD_EVENTS=api
STORAGE_AUTO_CREATE=true
