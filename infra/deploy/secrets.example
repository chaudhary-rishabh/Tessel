# Every value below is an SSM Parameter Store SecureString under /tessel/prod.
# deploy.sh turns /tessel/prod/NAME into NAME=value in /opt/tessel/.env.
# Create each one with:
#   aws ssm put-parameter --type SecureString --name /tessel/prod/NAME --value 'VALUE'

# Logging
LOG_LEVEL=info

# API
# The web app first (links in emails use it), then the admin app.
WEB_ORIGIN=https://app.example.com,https://admin.example.com
TRUST_PROXY=1
JWT_ACCESS_SECRET=<openssl rand -base64 48>
# Where browsers and MCP clients reach the API (OAuth redirects, sign-in for MCP clients).
API_PUBLIC_URL=https://api.example.com
# Where MCP clients reach Tessel's MCP server; tokens are issued for MCP_PUBLIC_URL/mcp.
MCP_PUBLIC_URL=https://mcp.example.com
# Encrypts connector tokens and two-factor secrets at rest. Keep it safe: changing it
# disconnects every connector and breaks everyone's two-factor codes.
ENCRYPTION_KEY=<openssl rand -base64 32>
# Account emails go through Amazon SES (infra/aws/README.md, section 3).
MAIL_TRANSPORT=ses
MAIL_FROM=Tessel <no-reply@example.com>
# Optional "Continue with Google / GitHub" (infra/aws/README.md, section 3). Each needs both values.
# GOOGLE_CLIENT_ID=<client ID>
# GOOGLE_CLIENT_SECRET=<client secret>
# GITHUB_CLIENT_ID=<client ID>
# GITHUB_CLIENT_SECRET=<client secret>
# Optional sign-in by text message through Amazon SNS. Leave unset to hide it.
# SMS_TRANSPORT=sns
# SMS_SENDER_ID=<registered sender ID>
# SMS_DLT_ENTITY_ID=<DLT entity ID, for Indian numbers>
# SMS_DLT_TEMPLATE_ID=<DLT template ID>
# Optional payments (infra/aws/README.md, section 3). Without them everyone stays on Free.
# STRIPE_SECRET_KEY=<sk_live_...>
# STRIPE_WEBHOOK_SECRET=<whsec_...>
# STRIPE_PRICE_PRO=<price ID>
# STRIPE_PRICE_MAX=<price ID>
# STRIPE_PRICE_TEAM=<price ID, charged per seat>
# STRIPE_PRICE_PRO_YEARLY=<yearly price ID, optional>
# STRIPE_PRICE_MAX_YEARLY=<yearly price ID, optional>
# STRIPE_PRICE_TEAM_YEARLY=<yearly price ID per seat, optional>
# RAZORPAY_KEY_ID=<rzp_live_...>
# RAZORPAY_KEY_SECRET=<key secret>
# RAZORPAY_WEBHOOK_SECRET=<webhook secret>
# RAZORPAY_PLAN_PRO=<plan ID>
# RAZORPAY_PLAN_MAX=<plan ID>
# RAZORPAY_PLAN_TEAM=<plan ID, charged per seat>
# RAZORPAY_PLAN_PRO_YEARLY=<yearly plan ID, optional>
# RAZORPAY_PLAN_MAX_YEARLY=<yearly plan ID, optional>
# RAZORPAY_PLAN_TEAM_YEARLY=<yearly plan ID per seat, optional>
# RAZORPAY_USD_TO_INR=85
# Optional GitHub OAuth app for the GitHub connector (callback: API_PUBLIC_URL/connectors/oauth/callback).
# GITHUB_MCP_CLIENT_ID=<client ID>
# GITHUB_MCP_CLIENT_SECRET=<client secret>

# Postgres (data profile). POSTGRES_PASSWORD is read by the postgres container.
POSTGRES_PASSWORD=<openssl rand -hex 24>
DATABASE_MIGRATION_URL=postgres://tessel:<POSTGRES_PASSWORD>@postgres:5432/tessel
DATABASE_URL=postgres://tessel_app:<openssl rand -hex 24>@postgres:5432/tessel

# Redis (data profile)
REDIS_CACHE_URL=redis://redis-cache:6379
REDIS_QUEUE_URL=redis://redis-queue:6379

# Qdrant and Neo4j (data profile). NEO4J_AUTH is read by the neo4j container.
QDRANT_URL=http://qdrant:6333
NEO4J_HTTP_URL=http://neo4j:7474
NEO4J_BOLT_URL=bolt://neo4j:7687
NEO4J_AUTH=neo4j/<openssl rand -hex 24>

# AI. AI_GATEWAY_API_KEY turns AI features on; the rest are optional.
AI_GATEWAY_API_KEY=<Vercel AI Gateway key>
# Emergency fallback when the gateway is down (optional):
# AI_FALLBACK_OPENAI_API_KEY=<OpenAI key>
# AI_FALLBACK_ANTHROPIC_API_KEY=<Anthropic key>
# Daily spend caps in US dollars (defaults: 5 per user, 50 per workspace, 500 overall):
# AI_DAILY_LIMIT_USER_USD=5
# AI_DAILY_LIMIT_WORKSPACE_USD=50
# AI_DAILY_LIMIT_GLOBAL_USD=500

# Voice (the voice profile): LiveKit carries the audio, the voice agent talks.
# One key pair, shared by LiveKit, the API (which signs room tokens), and the agent.
LIVEKIT_API_KEY=<API + openssl rand -hex 6>
LIVEKIT_API_SECRET=<openssl rand -base64 32>
# Where the API manages rooms (inside the stack) and where browsers connect (RTC_DOMAIN).
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=wss://rtc.example.com
# Optional: ElevenLabs directly, for the fastest speech and for users' own voices
# (read by both the API, which clones voices, and the voice agent, which speaks them).
# Without it, speech goes through the AI gateway with stock voices.
# ELEVENLABS_API_KEY=<ElevenLabs key>
# Longest voice conversation, in minutes (default 30).
# VOICE_MAX_SESSION_MINUTES=30

# Files and upload events (Amazon S3 and SQS). The EC2 instance role supplies
# credentials, so no AWS keys are stored. See infra/aws/README.md.
AWS_REGION=ap-south-1
S3_BUCKET=<your-bucket-name>
SQS_UPLOADS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<ACCOUNT_ID>/tessel-uploads
# S3 bucket notifications put upload events on the queue.
UPLOAD_EVENTS=s3
QDRANT_COLLECTION=tessel_chunks
QDRANT_EPISODES_COLLECTION=tessel_episodes
