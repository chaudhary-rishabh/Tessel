# Every value below is an SSM Parameter Store SecureString under /tessel/prod.
# deploy.sh turns /tessel/prod/NAME into NAME=value in /opt/tessel/.env.
# Create each one with:
#   aws ssm put-parameter --type SecureString --name /tessel/prod/NAME --value 'VALUE'

# Logging
LOG_LEVEL=info

# API
WEB_ORIGIN=https://app.example.com
TRUST_PROXY=1
JWT_ACCESS_SECRET=<openssl rand -base64 48>

# Postgres (data profile). POSTGRES_PASSWORD is read by the postgres container.
POSTGRES_PASSWORD=<openssl rand -hex 24>
DATABASE_MIGRATION_URL=postgres://tessel:<POSTGRES_PASSWORD>@postgres:5432/tessel
DATABASE_URL=postgres://tessel_app:<openssl rand -hex 24>@postgres:5432/tessel

# Redis (data profile)
REDIS_CACHE_URL=redis://redis-cache:6379
REDIS_QUEUE_URL=redis://redis-queue:6379

# Qdrant and Neo4j (data profile). NEO4J_AUTH is read by the neo4j container.
QDRANT_URL=http://qdrant:6333
NEO4J_HTTP_URL=http://neo4j:7474
NEO4J_AUTH=neo4j/<openssl rand -hex 24>
