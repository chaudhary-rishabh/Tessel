# Copy to .env for local development: cp .env.example .env
# Values below match infra/docker/docker-compose.yml. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=debug

# Apps
API_PORT=4000
MCP_PORT=4100
# Comma-separated web origins allowed to call the API with cookies.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MCP_URL=http://localhost:4100/mcp
# The API as the MCP server reaches it (http://api:4000 in Compose).
API_INTERNAL_URL=http://localhost:4000
# Number of proxies in front of the API (set to 1 behind a load balancer).
TRUST_PROXY=0

# Auth
# Generate a real secret with: openssl rand -base64 48
# Secrets containing "dev-only" are rejected when NODE_ENV=production.
JWT_ACCESS_SECRET=dev-only-secret-replace-me-with-openssl-rand-base64-48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Local development runs over plain HTTP; production always uses secure cookies.
COOKIE_SECURE=false

# Email (signup codes, password resets). "outbox" keeps messages in memory and
# logs them; read them at http://localhost:4000/dev/outbox. Production uses "ses".
MAIL_TRANSPORT=outbox
MAIL_FROM=Tessel <no-reply@localhost>

# Other ways to sign in. With SOCIAL_LOGIN_MOCK_URL set, "Continue with Google /
# GitHub" use the mock provider from `pnpm --filter @tessel/api mock-oauth` (port 4500).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SOCIAL_LOGIN_MOCK_URL=
# Texted sign-in codes: "outbox" (development, read at /dev/outbox), "sns", or "off".
SMS_TRANSPORT=outbox

# Where MCP clients reach Tessel's MCP server (the API signs them in with OAuth).
MCP_PUBLIC_URL=http://localhost:4100

# Connectors (MCP servers users connect to)
# Where browsers reach the API, for OAuth sign-in redirects.
API_PUBLIC_URL=http://localhost:4000
# Encrypts connector tokens and two-factor secrets at rest. Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=ZGV2LW9ubHktY29ubmVjdG9yLWtleS0zMi1ieXRlcyE=
# Lets connectors use http and local addresses. Never in production.
CONNECTORS_ALLOW_PRIVATE_NETWORKS=true
# The GitHub connector's server, and an optional GitHub OAuth app for it
# (callback URL: API_PUBLIC_URL/connectors/oauth/callback). Without one,
# users connect GitHub with a personal access token.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=

# Postgres
# The API connects as the restricted tessel_app role, so row-level security applies.
# `pnpm db:migrate` creates that login with this password.
DATABASE_URL=postgres://tessel_app:tessel_app_local@localhost:5432/tessel
# Migrations run as the database owner.
DATABASE_MIGRATION_URL=postgres://tessel:tessel@localhost:5432/tessel

# Redis: one instance for cache, one for queues (different eviction policies)
REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380

# Qdrant
QDRANT_URL=http://localhost:6333

# Neo4j
NEO4J_HTTP_URL=http://localhost:7474
# The knowledge graph (graph RAG). Leave NEO4J_BOLT_URL empty to turn it off.
NEO4J_BOLT_URL=bolt://localhost:7687
NEO4J_AUTH=neo4j/tessel-local-password
# Extract entities and relationships while indexing (costs model calls).
GRAPH_EXTRACTION=true

# AI (Vercel AI Gateway). Without a key, AI features are off.
# For offline development, run `pnpm --filter @tessel/ai mock-gateway` and set:
#   AI_GATEWAY_API_KEY=mock
#   AI_GATEWAY_URL=http://127.0.0.1:4300/v1
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
# Emergency fallback straight to a provider when the gateway is down. Optional.
AI_FALLBACK_OPENAI_API_KEY=
AI_FALLBACK_ANTHROPIC_API_KEY=
# Moderation of user messages: "model" (a small classifier model) or "off".
AI_MODERATION=model
# When the moderation check itself fails: "allow" the message or "block" it.
AI_MODERATION_ON_FAILURE=allow
# Daily spend caps in US dollars (0 turns a cap off). Reset at midnight UTC.
AI_DAILY_LIMIT_USER_USD=5
AI_DAILY_LIMIT_WORKSPACE_USD=50
AI_DAILY_LIMIT_GLOBAL_USD=500

# File storage and upload events. Locally: SeaweedFS (S3) and ElasticMQ (SQS)
# from `pnpm infra:up`. In production: Amazon S3 and SQS with the EC2
# instance role, so no access keys are set there.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tessel-local
AWS_SECRET_ACCESS_KEY=tessel-local-secret
S3_BUCKET=tessel-local
S3_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
SQS_ENDPOINT=http://localhost:9324
SQS_UPLOADS_QUEUE_URL=http://localhost:9324/000000000000/tessel-uploads
# The emulators can't send S3 bucket notifications, so the API announces uploads.
UPLOAD_EVENTS=api
# Create the bucket and queue on start. Never in production.
STORAGE_AUTO_CREATE=true
QDRANT_COLLECTION=tessel_chunks
QDRANT_EPISODES_COLLECTION=tessel_episodes
