# Copy to .env for local development: cp .env.example .env
# Values below match infra/docker/docker-compose.yml. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=debug

# Apps
API_PORT=4000
MCP_PORT=4100
# Comma-separated web origins allowed to call the API with cookies.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Number of proxies in front of the API (set to 1 behind a load balancer).
TRUST_PROXY=0

# Auth
# Generate a real secret with: openssl rand -base64 48
# Secrets containing "dev-only" are rejected when NODE_ENV=production.
JWT_ACCESS_SECRET=dev-only-secret-replace-me-with-openssl-rand-base64-48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Local development runs over plain HTTP; production always uses secure cookies.
COOKIE_SECURE=false

# Postgres
# The API connects as the restricted tessel_app role, so row-level security applies.
# `pnpm db:migrate` creates that login with this password.
DATABASE_URL=postgres://tessel_app:tessel_app_local@localhost:5432/tessel
# Migrations run as the database owner.
DATABASE_MIGRATION_URL=postgres://tessel:tessel@localhost:5432/tessel

# Redis: one instance for cache, one for queues (different eviction policies)
REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380

# Qdrant
QDRANT_URL=http://localhost:6333

# Neo4j
NEO4J_HTTP_URL=http://localhost:7474

# AI (Vercel AI Gateway). Without a key, AI features are off.
# For offline development, run `pnpm --filter @tessel/ai mock-gateway` and set:
#   AI_GATEWAY_API_KEY=mock
#   AI_GATEWAY_URL=http://127.0.0.1:4300/v1
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
# Emergency fallback straight to a provider when the gateway is down. Optional.
AI_FALLBACK_OPENAI_API_KEY=
AI_FALLBACK_ANTHROPIC_API_KEY=
# Moderation of user messages: "model" (a small classifier model) or "off".
AI_MODERATION=model
# When the moderation check itself fails: "allow" the message or "block" it.
AI_MODERATION_ON_FAILURE=allow
# Daily spend caps in US dollars (0 turns a cap off). Reset at midnight UTC.
AI_DAILY_LIMIT_USER_USD=5
AI_DAILY_LIMIT_WORKSPACE_USD=50
AI_DAILY_LIMIT_GLOBAL_USD=500
